    "compilerOptions": {
        "target": "es2022",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "module": "NodeNext",
        "outDir": "dist",
        "lib": [
            "es2022", "DOM"
        ],
        "strict": true,
        "allowImportingTsExtensions": true,
